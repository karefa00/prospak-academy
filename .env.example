APP_NAME="Prospak Academy"
APP_ENV=local
APP_DEBUG=false
APP_URL=http://prospak.test
# Generate with: php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
APP_KEY=REPLACE_WITH_64_HEX_RANDOM_CHARACTERS
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=prospak_academy
DB_USERNAME=prospak_app
DB_PASSWORD=REPLACE_WITH_LOCAL_DATABASE_PASSWORD
MAIL_FROM=no-reply@prospak.example
# PHP mail() requires a correctly configured sendmail-compatible local mail transport.
MAIL_ENABLED=false
SESSION_IDLE_MINUTES=30
